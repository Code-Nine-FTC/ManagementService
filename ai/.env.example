# Postgres connection
PGHOST=db
PGPORT=5432
PGDATABASE=teste
PGUSER=postgres
PGPASSWORD=fatec

# Trainer config
TRAIN_WINDOW_DAYS=120
FORECAST_HORIZON_DAYS=14
SCHEDULE_CRON=10 2 * * *
MODEL_VERSION=sarimax_v1
TRAIN_FORCE=false
# Timezone para o agendamento (ex.: America/Sao_Paulo)
TZ=America/Sao_Paulo

# Fonte de entrada (postgres | csv | parquet)
TRAIN_INPUT_SOURCE=postgres
# Quando for arquivo:
# TRAIN_INPUT_PATH=/path/para/dados.csv
# TRAIN_INPUT_FORMAT=csv
# INPUT_COL_ITEM=item_id
# INPUT_COL_DATE=date
# INPUT_COL_QTY=quantity
# INPUT_DATE_TZ=UTC

# Destino das previsões (database | file)
TRAIN_TARGET=database
# Para TRAIN_TARGET=file, diretório de saída
# OUTPUT_DIR=./output
